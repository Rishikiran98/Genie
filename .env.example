# Genie LLM configuration (optional).
#
# Genie runs out of the box with a deterministic, offline heuristic engine,
# so no credentials are required to try it. To use a real LLM for richer
# simulations, set the variables below. Any OpenAI-compatible Chat
# Completions endpoint works (OpenAI, Together, OpenRouter, local servers).

# Enables the LLM-backed engine when set. Leave empty to use the heuristic engine.
GENIE_LLM_API_KEY=

# OpenAI-compatible base URL (no trailing slash).
GENIE_LLM_BASE_URL=https://api.openai.com/v1

# Model id to request.
GENIE_LLM_MODEL=gpt-4o-mini

# --- Persistence (optional) ---
#
# Genie saves simulations in the browser (localStorage) by default — no setup
# needed. To persist them server-side in Supabase instead, set both variables
# below AND apply supabase/migrations/0001_init_simulations.sql to your project
# first (see the README). Leave empty to use browser storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
