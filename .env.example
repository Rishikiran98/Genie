# Genie LLM configuration (optional).
#
# Genie runs out of the box with a deterministic, offline heuristic engine,
# so no credentials are required to try it. To use a real LLM for richer
# simulations, set the variables below. Any OpenAI-compatible Chat
# Completions endpoint works (OpenAI, Together, OpenRouter, local servers).

# Enables the LLM-backed engine when set. Leave empty to use the heuristic engine.
GENIE_LLM_API_KEY=

# OpenAI-compatible base URL (no trailing slash).
GENIE_LLM_BASE_URL=https://api.openai.com/v1

# Model id to request.
GENIE_LLM_MODEL=gpt-4o-mini

# Max time to wait for one LLM call, in milliseconds (default 20000). On timeout
# Genie falls back to the offline engine rather than hanging the request.
GENIE_LLM_TIMEOUT_MS=20000

# --- API abuse protection ---
#
# Requests per minute allowed per client IP, per route (default 10). Set to 0
# to disable. Counters are in-memory, so on serverless hosting the limit is
# per instance, not global.
GENIE_RATE_LIMIT=10

# --- Observability ---
#
# Structured JSON logs go to stdout. Levels: debug | info | warn | error | silent
# (default info). User-entered idea text only appears at debug.
GENIE_LOG_LEVEL=info

# Optional salt for the hashed client IPs in logs. Set it to keep one client's
# hash stable across instances/restarts; unset, each process picks a random salt.
GENIE_IP_HASH_SALT=

# --- Persistence (optional) ---
#
# Genie saves simulations in the browser (localStorage) by default — no setup
# needed. To persist them server-side in Supabase instead, set both variables
# below AND apply supabase/migrations/0001_init_simulations.sql to your project
# first (see the README). Leave empty to use browser storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
