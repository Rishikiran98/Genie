{
  "name": "16-solo-founder-costs",
  "description": "A solo-founder constraint alone lowers feasibility and safety.",
  "input": {
    "idea": "A B2B SaaS dashboard that helps small accounting firms track client document requests and deadlines in one place",
    "targetUser": "Owners of 5-20 person accounting firms",
    "goal": "Get 10 paying firms at $49/month",
    "timeline": "6 weeks",
    "constraints": "solo founder, evenings only"
  },
  "assertions": [
    {
      "type": "lowerThan",
      "field": "report.scores.feasibility",
      "variant": {
        "constraints": null
      },
      "by": 3
    },
    {
      "type": "lowerThan",
      "field": "report.scores.executionRisk",
      "variant": {
        "constraints": null
      },
      "by": 3
    },
    {
      "type": "contains",
      "field": "report.risks",
      "pattern": "solo founder"
    },
    {
      "type": "noEllipsis"
    },
    {
      "type": "noRawIdea"
    }
  ]
}
