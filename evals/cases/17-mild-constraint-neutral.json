{
  "name": "17-mild-constraint-neutral",
  "description": "A deadline-style constraint is clarity, not friction: feasibility unchanged, confidence not lower.",
  "input": {
    "idea": "A B2B SaaS dashboard that helps small accounting firms track client document requests and deadlines in one place",
    "targetUser": "Owners of 5-20 person accounting firms",
    "goal": "Get 10 paying firms at $49/month",
    "timeline": "6 weeks",
    "constraints": "must ship before tax season"
  },
  "assertions": [
    {
      "type": "sameAs",
      "field": "report.scores.feasibility",
      "variant": {
        "constraints": null
      }
    },
    {
      "type": "sameAs",
      "field": "report.scores.executionRisk",
      "variant": {
        "constraints": null
      }
    },
    {
      "type": "higherThan",
      "field": "report.scores.confidence",
      "variant": {
        "constraints": null
      },
      "by": 0
    },
    {
      "type": "noEllipsis"
    },
    {
      "type": "noRawIdea"
    }
  ]
}
