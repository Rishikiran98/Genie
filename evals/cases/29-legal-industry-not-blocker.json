{
  "name": "29-legal-industry-not-blocker",
  "description": "Serving legal teams is an industry, not a regulatory constraint.",
  "input": {
    "idea": "A document search tool for legal teams that finds precedent clauses across past contracts",
    "targetUser": "Associates at mid-size law firms",
    "goal": "3 firms on a paid pilot"
  },
  "assertions": [
    {
      "type": "equals",
      "field": "binding.kind",
      "value": "willingness_to_pay"
    },
    {
      "type": "notMatches",
      "field": "report.risks",
      "pattern": "regulat"
    },
    {
      "type": "notMatches",
      "field": "report.experimentDesign",
      "pattern": "legal|jurisdiction"
    },
    {
      "type": "band",
      "field": "report.scores.feasibility",
      "min": 55
    },
    {
      "type": "noEllipsis"
    },
    {
      "type": "noRawIdea"
    }
  ]
}
